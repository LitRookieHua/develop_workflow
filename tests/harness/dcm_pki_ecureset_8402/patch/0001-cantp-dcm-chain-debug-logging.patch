 #include "ComM_Dcm.h"
 #include "Dcm_Prv.h"
 
+/* <T09PATCH P1> IDC310GAC-8402: debug logging for DCM->CanTp TX path black-hole analysis (Log_FunSync = LogSyncAcoreOnly) */
+extern void Log_FunSync(uint8 outputTarget, const char *fmt, ...);
+/* </T09PATCH P1> */
+
 /*
  **********************************************************************************************************************
  * Variables
@@ -670,15 +674,33 @@ Std_ReturnType Dcm_Prv_SendForcePendingResponse(void)
 void Dcm_Prv_SendResponse(const PduInfoType * PduInfoPcst)
 {
     uint32 dataTimeOutMonitor_u32;
+    /* <T09PATCH P1> */
+    Std_ReturnType t09TxRet;
+    if((PduInfoPcst != NULL_PTR) && (PduInfoPcst->SduLength >= 1u))
+    {
+        Log_FunSync(1U, "DCM TXR len=%d d0=%02x d1=%02x d2=%02x\r\n",
+                    (int)PduInfoPcst->SduLength,
+                    (int)PduInfoPcst->SduDataPtr[0],
+                    (int)((PduInfoPcst->SduLength > 1u) ? PduInfoPcst->SduDataPtr[1] : 0u),
+                    (int)((PduInfoPcst->SduLength > 2u) ? PduInfoPcst->SduDataPtr[2] : 0u));
+    }
+    /* </T09PATCH P1> */
     if(TRUE==DCM_CHKFULLCOMM_MODE(Dcm_Prv_GetActiveComMChannelIndex(Dcm_RxPduIdInProcess)))
     {
-        if(E_NOT_OK == PduR_DcmTransmit(Dcm_Prv_GetTxPduId(Dcm_RxPduIdInProcess), PduInfoPcst))
+        /* <T09PATCH P1> */
+        t09TxRet = PduR_DcmTransmit(Dcm_Prv_GetTxPduId(Dcm_RxPduIdInProcess), PduInfoPcst);
+        Log_FunSync(1U, "DCM TXRD ret=%d\r\n", (int)t09TxRet);
+        if(E_NOT_OK == t09TxRet)
         {
             Dcm_Dsl_ResponseTypeCheck();
         }
+        /* </T09PATCH P1> */
     }
     else
     {
+        /* <T09PATCH P1> full-comm not active: response deferred (P2 check / retransmission registration) */
+        Log_FunSync(1U, "DCM TXRD full=0\r\n");
+        /* </T09PATCH P1> */
         SchM_Enter_Dcm_DsldTimer();
         dataTimeOutMonitor_u32 = Dcm_Prv_Get_DataTimeOut(Dcm_ReqIndexInProcess);
         DCM_TimerProcess(dataTimeOutMonitor_u32,Dcm_P2OrS3StartTick_u32,Dcm_P2OrS3TimerStatus_uchr)
