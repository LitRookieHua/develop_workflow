@@ -18,6 +18,11 @@
 #include "Dcm.h"
 #include "Dcm_Prv.h"
 
+/* <T09PATCH P1> IDC310GAC-8402: debug logging for diag RX black-hole analysis (Log_FunSync = LogSyncAcoreOnly) */
+extern void Log_FunSync(uint8 outputTarget, const char *fmt, ...);
+#define DCM_T09_IS_TP_PAYLOAD(p)  ( (p)[0] == 0x3Eu && (p)[1] == 0x80u )
+/* </T09PATCH P1> */
+
 /*
  **********************************************************************************************************************
  * Variables
@@ -732,6 +737,16 @@ static BufReq_ReturnType Dcm_ProcessNewRequest (PduIdType dcmRxPduId, const PduI
          *  OR (Dcm is Busy Processing a Request)*/
         if(Dcm_Prv_IsDslBusyWithRequest(dcmRxPduId,&isReqFromSameConn))
         {
+            /* <T09PATCH P1> DSL busy gate hit - request queued as NRC21 or preemption */
+            if((info != NULL_PTR) && !((info->SduLength >= 2u) && (TRUE == DCM_T09_IS_TP_PAYLOAD(info->SduDataPtr))))
+            {
+                Log_FunSync(1U, "DCM BUSY id=%d same=%d d0=%02x d1=%02x\r\n",
+                            (int)dcmRxPduId,
+                            (int)isReqFromSameConn,
+                            (int)((info->SduLength > 0u) ? info->SduDataPtr[0] : 0u),
+                            (int)((info->SduLength > 1u) ? info->SduDataPtr[1] : 0u));
+            }
+            /* </T09PATCH P1> */
             bufRequestStatus_en= Dcm_ProcessRequestWhileDslBusy(dcmRxPduId,tpSduLength,isReqFromSameConn);
             if(BUFREQ_OK==bufRequestStatus_en)
             {
@@ -1014,6 +1029,26 @@ BufReq_ReturnType Dcm_StartOfReception (
 {
     BufReq_ReturnType bufRequestStatus_en = BUFREQ_E_NOT_OK;
     Dcm_MsgLenType bufferSize;
+    /* <T09PATCH P1> */
+    if((info != NULL_PTR) && (info->SduLength >= 2u) && (TRUE == DCM_T09_IS_TP_PAYLOAD(info->SduDataPtr)))
+    {
+        /* tester-present keepalive: skip entry/exit logs to avoid flooding */
+    }
+    else if(info != NULL_PTR)
+    {
+        Log_FunSync(1U, "DCM SOR id=%d len=%d d0=%02x d1=%02x d2=%02x d3=%02x\r\n",
+                    (int)id,
+                    (int)tpSduLength,
+                    (int)info->SduDataPtr[0],
+                    (int)((info->SduLength > 1u) ? info->SduDataPtr[1] : 0u),
+                    (int)((info->SduLength > 2u) ? info->SduDataPtr[2] : 0u),
+                    (int)((info->SduLength > 3u) ? info->SduDataPtr[3] : 0u));
+    }
+    else
+    {
+        Log_FunSync(1U, "DCM SOR id=%d nullinfo len=%d\r\n", (int)id, (int)tpSduLength);
+    }
+    /* </T09PATCH P1> */
     /* check all prameters are valid */
     if ((BUFREQ_OK== Dcm_Prv_CheckEnvironment(id,info,bufferSizePtr)))
     {
@@ -1036,6 +1071,12 @@ BufReq_ReturnType Dcm_StartOfReception (
             }
         }
     }
+    /* <T09PATCH P1> */
+    if(!((info != NULL_PTR) && (info->SduLength >= 2u) && (TRUE == DCM_T09_IS_TP_PAYLOAD(info->SduDataPtr))))
+    {
+        Log_FunSync(1U, "DCM SORRET id=%d ret=%d\r\n", (int)id, (int)bufRequestStatus_en);
+    }
+    /* </T09PATCH P1> */
     return (bufRequestStatus_en);
 }
 
diff --git a/cpj_gac/autosar/t09/BswRta/src/bsw/Dcm/src/Dsl/Dcm_Transmission/Dcm_Dsl_ResponseTransmission.c b/cpj_gac/autosar/t09/BswRta/src/bsw/Dcm/src/Dsl/Dcm_Transmission/Dcm_Dsl_ResponseTransmission.c
